{
  "description": "LERNECKE: Lernstand beim Sessionstart einspielen",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m lern brief --hook",
            "commandWindows": "powershell -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.venv/Scripts/python.exe') -m lern brief --hook\"",
            "timeout": 30,
            "statusMessage": "Lade Lernstand"
          }
        ]
      }
    ]
  }
}
