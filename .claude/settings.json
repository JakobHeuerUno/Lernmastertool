{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m lern brief --hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m lern:*)",
      "Bash(.venv/Scripts/python.exe -m lern:*)",
      "Bash(./lern.cmd:*)"
    ]
  }
}
