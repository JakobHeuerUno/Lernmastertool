{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/lern\" brief --hook",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./lern:*)",
      "Bash(sh lern:*)",
      "Bash(sh ./lern:*)",
      "Bash(./lern.cmd:*)",
      "Bash(.venv/bin/python -m lern:*)",
      "Bash(.venv/Scripts/python -m lern:*)",
      "Bash(.venv/Scripts/python.exe -m lern:*)",
      "Bash(sh setup.sh:*)"
    ]
  }
}
