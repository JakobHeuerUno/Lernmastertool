__pycache__/
*.egg-info/
.pytest_cache/
.cache/
ausgabe/
# Originalmaterial (groß, urheberrechtlich geschützt) und generierte Texte bleiben lokal
kurse/*/inbox/*
!kurse/*/inbox/.gitkeep
kurse/*/material/**/*
!kurse/*/material/*/
!kurse/*/material/*/.gitkeep
kurse/*/text/
# Videos/Audio (gross, nicht eingelesen): kurse/<id>/medien/, gleiche Unterordner wie material/
kurse/*/medien/
# Link auf .agents/skills (wird von einrichten.py erzeugt: Windows Junction, sonst Symlink)
.claude/skills
# Lokale Einstellungen (Material-Links/Passwörter) – nie committen
lern.lokal.yaml
